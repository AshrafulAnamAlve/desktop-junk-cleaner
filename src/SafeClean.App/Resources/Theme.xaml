<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Colour tokens. Contrast checked against WCAG AA (text >= 4.5:1); see docs/phases/PHASE-01. -->

  <!-- Surfaces -->
  <Color x:Key="Color.Window">#0F1216</Color>
  <Color x:Key="Color.Sidebar">#13171C</Color>
  <Color x:Key="Color.Card">#181D23</Color>
  <Color x:Key="Color.Hover">#1F252D</Color>
  <Color x:Key="Color.Selected">#232B36</Color>
  <Color x:Key="Color.Border">#2A313A</Color>

  <!-- Text -->
  <Color x:Key="Color.Text.Primary">#E6EAF0</Color>
  <Color x:Key="Color.Text.Secondary">#A8B2BF</Color>
  <Color x:Key="Color.Text.Muted">#8B96A5</Color>

  <!-- Accent: non-destructive primary actions -->
  <Color x:Key="Color.Accent">#5AA2FF</Color>
  <Color x:Key="Color.Accent.Hover">#78B4FF</Color>
  <Color x:Key="Color.Accent.Pressed">#4A8FE8</Color>
  <Color x:Key="Color.OnAccent">#0B1524</Color>
  <Color x:Key="Color.Accent.Soft">#1B2B40</Color>
  <Color x:Key="Color.Accent.SoftText">#8EC0FF</Color>

  <!-- States (Danger is reserved for destructive actions) -->
  <Color x:Key="Color.Success">#4CC38A</Color>
  <Color x:Key="Color.Warning">#E3B341</Color>
  <Color x:Key="Color.Warning.Soft">#33291A</Color>
  <Color x:Key="Color.Danger">#F2645A</Color>
  <Color x:Key="Color.Disabled.Background">#252B33</Color>
  <Color x:Key="Color.Disabled.Text">#7A8594</Color>
  <Color x:Key="Color.Focus">#8EC0FF</Color>

  <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
  <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
  <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}" />
  <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
  <SolidColorBrush x:Key="Brush.Selected" Color="{StaticResource Color.Selected}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
  <SolidColorBrush x:Key="Brush.Accent.Soft" Color="{StaticResource Color.Accent.Soft}" />
  <SolidColorBrush x:Key="Brush.Accent.SoftText" Color="{StaticResource Color.Accent.SoftText}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.Warning.Soft" Color="{StaticResource Color.Warning.Soft}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.Disabled.Background" Color="{StaticResource Color.Disabled.Background}" />
  <SolidColorBrush x:Key="Brush.Disabled.Text" Color="{StaticResource Color.Disabled.Text}" />
  <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Focus}" />

  <!-- Fonts built into Windows (Windows 11 names first, Windows 10 fallbacks second) -->
  <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
