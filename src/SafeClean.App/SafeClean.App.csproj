<Project Sdk="Microsoft.NET.Sdk">

  <!-- The WPF user interface. Shows data and forwards user intent; never decides what may be deleted. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>SafeClean</AssemblyName>
    <RootNamespace>SafeClean.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeClean.Core\SafeClean.Core.csproj" />
    <ProjectReference Include="..\SafeClean.Infrastructure\SafeClean.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SafeClean.App.Tests" />
  </ItemGroup>

</Project>
