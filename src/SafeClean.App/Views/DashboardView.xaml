<UserControl x:Class="SafeClean.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SafeClean.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="40,0,40,32">
    <!-- Live, read-only figures. Anything not measured yet says "—" / "Measuring…" instead of an invented number. -->
    <StackPanel>
      <controls:AdaptiveColumnsPanel MinColumnWidth="190" MaxColumns="4" Spacing="16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Text.CardIcon}" Text="&#xE964;" />
              <TextBlock Style="{StaticResource Text.CardTitle}" Text="Memory" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.MetricValue}" Text="{Binding MemoryValue}"
                       AutomationProperties.Name="{Binding MemoryValue, StringFormat='Memory in use: {0}'}" />
            <ProgressBar Value="{Binding MemoryPercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,8"
                         Visibility="{Binding HasMemory, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Memory in use" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding MemoryDetail}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Text.CardIcon}" Text="&#xE9D9;" />
              <TextBlock Style="{StaticResource Text.CardTitle}" Text="Processor" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.MetricValue}" Text="{Binding CpuValue}"
                       AutomationProperties.Name="{Binding CpuValue, StringFormat='Processor use: {0}'}" />
            <ProgressBar Value="{Binding CpuPercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,8"
                         Visibility="{Binding HasCpu, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Processor use" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding CpuDetail}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Text.CardIcon}" Text="&#xEDA2;" />
              <TextBlock Style="{StaticResource Text.CardTitle}" Text="{Binding DriveTitle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.MetricValue}" Text="{Binding DriveValue}"
                       AutomationProperties.Name="{Binding DriveValue, StringFormat='System drive used: {0}'}" />
            <ProgressBar Value="{Binding DrivePercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,8"
                         Visibility="{Binding HasDrive, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="System drive used" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding DriveDetail}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Text.CardIcon}" Text="&#xE74D;" />
              <TextBlock Style="{StaticResource Text.CardTitle}" Text="Junk files" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.MetricValue}" Text="{Binding JunkValue}"
                       AutomationProperties.Name="{Binding JunkValue, StringFormat='Junk files: {0}'}" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding JunkDetail}" Margin="0,4,0,10" />
            <Button Style="{StaticResource Button.Secondary}" Command="{Binding ScanCommand}" Content="Scan Temp folder"
                    HorizontalAlignment="Left" Padding="12,6" AutomationProperties.Name="Scan Temp folder (read-only)" />
          </StackPanel>
        </Border>
      </controls:AdaptiveColumnsPanel>

      <!-- Full width: lines up exactly with the cards above (same right edge) -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.CardTitle}" Text="Safety status" Margin="0,0,0,14" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" FontFamily="{StaticResource Font.Icons}" Margin="0,4">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="&#xE73E;" />
                  <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRealMode}" Value="True">
                      <Setter Property="Text" Value="&#xE7BA;" />
                      <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Cleanup mode" Margin="0,2" />
            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Text.Body}" Text="{Binding ModeText}" Margin="0,2" />

            <TextBlock Grid.Row="1" FontFamily="{StaticResource Font.Icons}" Margin="0,4">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="&#xE73E;" />
                  <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsElevated}" Value="True">
                      <Setter Property="Text" Value="&#xE7BA;" />
                      <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="User rights" Margin="0,2" />
            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Text.Body}" Text="{Binding RightsText}" Margin="0,2" />

            <TextBlock Grid.Row="2" Text="&#xE73E;" FontFamily="{StaticResource Font.Icons}" Foreground="{StaticResource Brush.Success}" Margin="0,4" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Privacy" Margin="0,2" />
            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Text.Body}" Text="Works fully offline. Nothing about your files leaves this PC." Margin="0,2" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
