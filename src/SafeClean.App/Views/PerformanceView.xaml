<UserControl x:Class="SafeClean.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Style="{StaticResource Card}" Padding="32">
      <StackPanel HorizontalAlignment="Center" MaxWidth="560">
        <Border Style="{StaticResource EmptyStateIcon}">
          <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Font.Icons}" FontSize="22"
                     Foreground="{StaticResource Brush.Accent.SoftText}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Style="{StaticResource Text.EmptyTitle}" Text="Live monitoring isn't connected yet"
                   HorizontalAlignment="Center" Margin="0,16,0,8" />
        <TextBlock Style="{StaticResource Text.Body}" TextAlignment="Center"
                   Text="This screen will show memory, processor and disk usage, and how much memory each running program reports. It only reads information. It never closes programs or changes system settings." />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <TextBlock Style="{StaticResource Text.CardIcon}" Text="&#xE946;" />
          <TextBlock Style="{StaticResource Text.CardTitle}" Text="Why high memory usage is normal" />
        </StackPanel>
        <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,10"
                   Text="Windows deliberately keeps recently used data in spare memory (RAM) so programs and files open faster. This cache is handed back instantly whenever a program needs the memory, so a high memory figure on a healthy PC is expected." />
        <TextBlock Style="{StaticResource Text.Body}"
                   Text="&quot;RAM cleaner&quot; tools that force this cache out usually make the computer slower afterwards, because Windows has to load everything again. That is why SafeClean shows memory information but never &quot;cleans&quot; memory." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
