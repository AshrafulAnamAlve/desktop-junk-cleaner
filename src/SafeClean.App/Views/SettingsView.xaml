<UserControl x:Class="SafeClean.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <TextBlock Style="{StaticResource Text.CardIcon}" Text="&#xE7B3;" />
          <TextBlock Style="{StaticResource Text.CardTitle}" Text="Cleanup mode" />
        </StackPanel>
        <TextBlock Style="{StaticResource Text.Body}"
                   Text="Dry Run (preview only). SafeClean always starts in this mode. Real cleanup can't be switched on in this version yet." />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <TextBlock Style="{StaticResource Text.CardIcon}" Text="&#xE8A5;" />
          <TextBlock Style="{StaticResource Text.CardTitle}" Text="Logs" />
        </StackPanel>
        <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,12"
                   Text="SafeClean keeps a local record of what it does. Logs never contain file contents, and your user folder is written as %USERPROFILE%." />
        <TextBlock Style="{StaticResource Text.Caption}" Text="Log folder" Margin="0,0,0,4" />
        <TextBox Style="{StaticResource TextBox.ReadOnly}" Text="{Binding LogDirectory, Mode=OneWay}"
                 AutomationProperties.Name="Log folder path" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <TextBlock Style="{StaticResource Text.CardIcon}" Text="&#xE946;" />
          <TextBlock Style="{StaticResource Text.CardTitle}" Text="About" />
        </StackPanel>
        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Version, StringFormat='SafeClean version {0}'}" />
        <TextBlock Style="{StaticResource Text.Body}" Text="Free. Works offline. Sends no data anywhere." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
