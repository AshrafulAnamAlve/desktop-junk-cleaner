<UserControl x:Class="SafeClean.App.Views.JunkCleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Style="{StaticResource Card}" Padding="32">
      <StackPanel HorizontalAlignment="Center" MaxWidth="560">
        <Border Style="{StaticResource EmptyStateIcon}">
          <TextBlock Text="&#xE721;" FontFamily="{StaticResource Font.Icons}" FontSize="22"
                     Foreground="{StaticResource Brush.Accent.SoftText}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Style="{StaticResource Text.EmptyTitle}" Text="Scanning isn't available yet"
                   HorizontalAlignment="Center" Margin="0,16,0,8" />
        <TextBlock Style="{StaticResource Text.Body}" TextAlignment="Center"
                   Text="This screen will scan only your own Temp folder. Scanning is read-only: it lists files and explains why each one is or isn't safe to remove. Nothing is deleted unless you select files, switch on real cleanup and confirm." />
        <Button Style="{StaticResource Button.Primary}" Content="Scan Temp folder" IsEnabled="False"
                HorizontalAlignment="Center" Margin="0,22,0,0"
                ToolTipService.ShowOnDisabled="True" ToolTip="Not available in this version yet" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock Style="{StaticResource Text.CardTitle}" Text="How SafeClean will decide what is safe" Margin="0,0,0,12" />
        <TextBlock Style="{StaticResource Text.Body}" Text="A file is offered for cleanup only if all of these are true:" Margin="0,0,0,8" />
        <TextBlock Style="{StaticResource Text.Body}" Text="•  It is inside your own Temp folder, not a shortcut or link to somewhere else." />
        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding AgeRuleText, StringFormat='•  {0}'}" />
        <TextBlock Style="{StaticResource Text.Body}" Text="•  It is not read-only, hidden, a system file, or stored in the cloud." />
        <TextBlock Style="{StaticResource Text.Body}" Text="•  No program is using it, and it hasn't changed since the scan (checked again right before deletion)." />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,12,0,0"
                   Text="A file's name or extension alone never makes it safe. When in doubt, SafeClean skips the file." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
