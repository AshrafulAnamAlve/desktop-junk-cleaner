<UserControl x:Class="SafeClean.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SafeClean.App.ViewModels">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="40,0,40,32">
    <StackPanel>
      <!-- No cleanups yet -->
      <Border Style="{StaticResource Card}" Padding="32" VerticalAlignment="Top"
              Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
        <StackPanel HorizontalAlignment="Center" MaxWidth="560">
          <Border Style="{StaticResource EmptyStateIcon}">
            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Font.Icons}" FontSize="22"
                       Foreground="{StaticResource Brush.Accent.SoftText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Style="{StaticResource Text.EmptyTitle}" Text="No cleanups yet" HorizontalAlignment="Center" Margin="0,16,0,8" />
          <TextBlock Style="{StaticResource Text.Body}" TextAlignment="Center"
                     Text="Each real cleanup is listed here with its date, how many files were deleted, skipped or failed, and the space actually freed. File names are never stored." />
        </StackPanel>
      </Border>

      <!-- Past cleanups, newest first -->
      <Border Style="{StaticResource Card}" Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Command="{Binding ClearCommand}" Content="Clear history…" />
            <TextBlock Style="{StaticResource Text.CardTitle}" Text="Past cleanups (newest first)" VerticalAlignment="Center" />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Entries}" Focusable="False" AutomationProperties.Name="Past cleanups">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:HistoryRowViewModel}">
                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="170" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding What}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0">
                      <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding DurationText, StringFormat='Took {0}'}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding FreedText}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Success}" VerticalAlignment="Top" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding SkippedLinesText}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Warning}" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
