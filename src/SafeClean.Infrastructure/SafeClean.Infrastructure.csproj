<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that talks to Windows: file system, native APIs, monitoring, logging.
       Must never reference WPF or the App project. -->
  <PropertyGroup>
    <RootNamespace>SafeClean.Infrastructure</RootNamespace>
    <!-- Needed for the source-generated Windows calls (LibraryImport) and their memory buffers.
         A test enforces that "unsafe" code only appears in the Native/ folder. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeClean.Core\SafeClean.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SafeClean.Infrastructure.Tests" />
  </ItemGroup>

</Project>
